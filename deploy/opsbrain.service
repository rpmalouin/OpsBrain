[Unit]
Description=Ops Brain - homelab monitor/reasoner/remediator (qwen3.5:27b on the ollama box)
# 2026-11-22: `ollama.service` was dropped from After= — this host has no local ollama any more
# (stack retired 2026-11-13; the LLM lives on the ollama box at 10.1.10.30, reached over HTTP).
# Ordering after a unit that does not exist here only misled the reader.
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/appdata/OpsBrain
Environment=OPSBRAIN_REPO=/appdata/OpsBrain
Environment=PYTHONUNBUFFERED=1
# The repo carries its own venv (python 3.14): requirements.txt plus the dashboard's
# fastapi/uvicorn/jinja2/watchdog set. /usr/bin/python3 has no fastapi, so anything started with
# the bare system interpreter breaks the dashboard import.
ExecStart=/appdata/OpsBrain/.venv/bin/python /appdata/OpsBrain/scheduler/scheduler.py --daemon
Restart=always
RestartSec=15
Nice=5

[Install]
WantedBy=multi-user.target
